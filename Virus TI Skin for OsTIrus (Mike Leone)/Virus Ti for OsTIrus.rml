<rml>
    <head>
        <!--        Templates and Rcss TUS-->
        <link type="text/template" href="tus_colorpicker.rml" />
        <link type="text/template" href="tus_patchmanager.rml" />
        <link type="text/rcss" href="tus_default.rcss" />
        <!--        <link type="text/rcss" href="tus_colorpicker.rcss" />-->
        <!--        <link type="text/rcss" href="tus_patchmanager.rcss" />-->
        <!--        <link type="text/rcss" href="tus_juceskin.rcss" />-->
        <!--        <link type="text/rcss" href="PatchManager.rcss" />-->
        <!--        <link type="text/rcss" href="Colorpicker.rcss" />-->
        <!--        Rcss-->
        <link type="text/rcss" href="Global.rcss" />
        <link type="text/rcss" href="Menu.rcss" />
        <link type="text/rcss" href="Class.rcss" />
        <link type="text/rcss" href="Spritesheet.rcss" />
        <link type="text/rcss" href="Patch-Manager.rcss" />
        <!--        <link type="text/rcss" href="Patchmanager Font TeXGyre Heros.rcss" />-->
        <!--        Lua Scripts-->
        <script src="Custom-Display.lua"></script>
        <script src="Part-Manager.lua"></script>
        <script src="Oscillator.lua"></script>
        <script src="Filter-Cutoff.lua"></script>
        <script src="ADSR.lua"></script>
        <script src="LFO.lua"></script>
        <script src="Arpeggiator.lua"></script>
        <!--        Lookup Table for Lua-->
        <script src="Wavetables-Data.lua"></script>
        <script src="Arpeggiator-Presets.lua"></script>
    </head>
    <body rootScale="0.5" data-model="partCurrent" onload="Custom_Display(); Part_Manager(); Oscillator(); Filter_Cutoff(); ADSR(); LFO(); Arpeggiator();">
    <page id="Main">
        <img src="Page-Main.png" />
        <section id="Button-Page">
            <button id="Button-Page-Easy" class="Button-Page-Easy" tabgroup="pages" tabbutton="0" isToggle="1" style="left: 428dp; top: 30dp" />
            <button id="Button-Page-Browser" class="Button-Page-Browser" tabgroup="pages" tabbutton="1" isToggle="1" style="left: 554dp; top: 30dp" />
            <button id="Button-Page-Osc" class="Button-Page-Osc" tabgroup="pages" tabbutton="2" isToggle="1" style="left: 680dp; top: 30dp" />
            <button id="Button-Page-Filter" class="Button-Page-Filter" tabgroup="pages" tabbutton="3" isToggle="1" style="left: 806dp; top: 30dp" />
            <button id="Button-Page-Lfo" class="Button-Page-Lfo" tabgroup="pages" tabbutton="4" isToggle="1" style="left: 932dp; top: 30dp" />
            <button id="Button-Page-Matrix" class="Button-Page-Matrix" tabgroup="pages" tabbutton="5" isToggle="1" style="left: 1058dp; top: 30dp" />
            <button id="Button-Page-Arp" class="Button-Page-Arp" tabgroup="pages" tabbutton="6" isToggle="1" style="left: 1184dp; top: 30dp" />
            <button id="Button-Page-FX-1" class="Button-Page-FX-1" tabgroup="pages" tabbutton="7" isToggle="1" style="left: 1310dp; top: 30dp" />
            <button id="Button-Page-FX-2" class="Button-Page-FX-2" tabgroup="pages" tabbutton="8" isToggle="1" style="left: 1436dp; top: 30dp" />
            <button id="Button-Page-Common" class="Button-Page-Common" tabgroup="pages" tabbutton="9" isToggle="1" style="left: 1562dp; top: 30dp" />
            <button id="Button-Page-Info" class="Button-Page-Info" tabgroup="pages" tabbutton="10" isToggle="1" style="left: 1688dp; top: 30dp; width: 70dp; height: 38dp" />
        </section>
        <section id="LCD">
            <button id="PlayModeToggle" class="Button-Mode" isToggle="1" style="left: 20dp; top: 946dp" />
            <label id="PatchName" class="label-main" style="left: 854dp; top: 976dp; width: 238dp; height: 18dp"></label>
            <label id="FocusedParameterValue" class="label-main" style="left: 434dp; top: 976dp; width: 334dp; height: 18dp"></label>
            <label id="FocusedParameterName" class="label-main" style="left: 434dp; top: 954dp; width: 658dp; height: 18dp; color: #ededed"></label>
            <label id="Custom-Focused-Value" class="label-main" style="z-index: 10; left: 434dp; top: 976dp; width: 334dp; height: 18dp"></label>
            <label id="Custom-Focused-Name" class="label-main" style="z-index: 10; left: 434dp; top: 954dp; width: 658dp; height: 18dp; color: #ededed"></label>
            <label id="VersionNumber" class="label-main" style="left: 1298dp; top: 954dp; width: 334dp; height: 18dp; color: #50d7f2"></label>
            <combo id="RomSelector" class="combo-main" style="left: 1238dp; top: 976dp; width: 394dp; height: 18dp">
                <combotext style="color: #50d7f2"></combotext>
            </combo>
            <button id="Button-Help" class="Button-Help" url="https://theusualsuspects.io/" isToggle="1" style="left: 1712dp; top: 946dp" />
        </section>
        <section id="Part-Manager" data-model="partCurrent" style="left: 12dp; top: 96dp; width: 362dp; height: 834dp">
            <section id="Background">
                <section id="Single-Mode" data-class-disabled="Play_Mode_value > 0">
                    <img id="Virus-TI" data-model="plugin" src="Play-Mode-Single-Virus-TI.png" data-class-disabled="deviceModel == 'Snow'" />
                    <img id="Virus-Snow" data-model="plugin" src="Play-Mode-Single-Virus-Snow.png" data-class-disabled="deviceModel == 'TI2'" />
                </section>
                <section id="Multi-Mode" data-class-disabled="Play_Mode_value == 0">
                    <img id="Virus-TI" data-model="plugin" src="Play-Mode-Multi-Virus-TI.png" data-class-disabled="deviceModel == 'Snow'" />
                    <img id="Virus-Snow" data-model="plugin" src="Play-Mode-Multi-Virus-Snow.png" data-class-disabled="deviceModel == 'TI2'" />
                </section>
            </section>
            <section id="Single-Mode">
                <section id="Part-0" class="Part-0" data-model="plugin" data-class-Snow="deviceModel == 'Snow'">
                    <section data-model="part0">
                        <button id="PresetLoad" />
                        <button id="PresetSave" />
                        <button id="Preset-Load-0" class="Button-Load" />
                        <button id="Preset-Save-0" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-0" class="Slider-Mini" param="Patch Volume" type="range" data-class-disabled="Play_Mode_value > 0" />
                        <input id="Part-Volume-0" class="Slider-Mini" param="Part Volume" type="range" data-class-disabled="Play_Mode_value == 0" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <input id="Part-Pan-Snow-0" class="Slider-Mini-Snow" param="Panorama" type="range" />
                        <button id="SelectPart" class="Button-Part-1" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-0" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                </section>
            </section>
            <section id="Multi-Mode" data-class-disabled="Play_Mode_value == 0">
                <section id="Snow">
                    <section id="Part-1" class="Part-1" data-model="plugin" data-class-Snow="deviceModel == 'Snow'">
                        <section data-model="part1">
                            <button id="Preset-Load-1" class="Button-Load" />
                            <button id="Preset-Save-1" class="Button-Save" />
                            <knob id="PartVolume" />
                            <input id="Part-Volume-1" class="Slider-Mini" param="Part Volume" type="range" />
                            <knob id="PartPan" class="Knob-Mini" />
                            <input id="Part-Pan-Snow-1" class="Slider-Mini-Snow" param="Panorama" type="range" />
                            <button id="SelectPart" class="Button-Part-2" />
                            <button id="PresetPrev" class="Button-Preset-Up" />
                            <button id="PresetNext" class="Button-Preset-Down" />
                            <combo id="Preset-Name-1" class="Preset-Name">
                                <combotext id="PresetName"></combotext>
                            </combo>
                        </section>
                    </section>
                    <section id="Part-2" class="Part-2" data-model="plugin" data-class-Snow="deviceModel == 'Snow'">
                        <section data-model="part2">
                            <button id="Preset-Load-2" class="Button-Load" />
                            <button id="Preset-Save-2" class="Button-Save" />
                            <knob id="PartVolume" />
                            <input id="Part-Volume-2" class="Slider-Mini" param="Part Volume" type="range" />
                            <knob id="PartPan" class="Knob-Mini" />
                            <input id="Part-Pan-Snow-2" class="Slider-Mini-Snow" param="Panorama" type="range" />
                            <button id="SelectPart" class="Button-Part-3" />
                            <button id="PresetPrev" class="Button-Preset-Up" />
                            <button id="PresetNext" class="Button-Preset-Down" />
                            <combo id="Preset-Name-2" class="Preset-Name">
                                <combotext id="PresetName"></combotext>
                            </combo>
                        </section>
                    </section>
                    <section id="Part-3" class="Part-3" data-model="plugin" data-class-Snow="deviceModel == 'Snow'">
                        <section data-model="part3">
                            <button id="Preset-Load-3" class="Button-Load" />
                            <button id="Preset-Save-3" class="Button-Save" />
                            <knob id="PartVolume" />
                            <input id="Part-Volume-3" class="Slider-Mini" param="Part Volume" type="range" />
                            <knob id="PartPan" class="Knob-Mini" />
                            <input id="Part-Pan-Snow-3" class="Slider-Mini-Snow" param="Panorama" type="range" />
                            <button id="SelectPart" class="Button-Part-4" />
                            <button id="PresetPrev" class="Button-Preset-Up" />
                            <button id="PresetNext" class="Button-Preset-Down" />
                            <combo id="Preset-Name-3" class="Preset-Name">
                                <combotext id="PresetName"></combotext>
                            </combo>
                        </section>
                    </section>
                </section>
                <section id="Virus-TI" data-model="plugin" data-class-disabled="deviceModel == 'Snow'">
                    <section id="Part-4" data-model="part4" style="left: 12dp; top: 212dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-4" class="Button-Load" />
                        <button id="Preset-Save-4" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-4" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-5" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-4" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-5" data-model="part5" style="left: 12dp; top: 264dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-5" class="Button-Load" />
                        <button id="Preset-Save-5" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-5" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-6" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-5" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-6" data-model="part6" style="left: 12dp; top: 316dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-6" class="Button-Load" />
                        <button id="Preset-Save-6" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-6" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-7" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-6" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-7" data-model="part7" style="left: 12dp; top: 368dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-7" class="Button-Load" />
                        <button id="Preset-Save-7" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-7" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-8" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-7" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-8" data-model="part8" style="left: 12dp; top: 420dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-8" class="Button-Load" />
                        <button id="Preset-Save-8" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-8" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-9" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-8" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-9" data-model="part9" style="left: 12dp; top: 472dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-9" class="Button-Load" />
                        <button id="Preset-Save-9" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-9" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-10" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-9" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-10" data-model="part10" style="left: 12dp; top: 524dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-10" class="Button-Load" />
                        <button id="Preset-Save-10" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-10" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-11" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-10" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-11" data-model="part11" style="left: 12dp; top: 576dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-11" class="Button-Load" />
                        <button id="Preset-Save-11" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-11" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-12" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-11" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-12" data-model="part12" style="left: 12dp; top: 628dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-12" class="Button-Load" />
                        <button id="Preset-Save-12" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-12" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-13" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-12" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-13" data-model="part13" style="left: 12dp; top: 680dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-13" class="Button-Load" />
                        <button id="Preset-Save-13" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-13" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-14" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-13" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-14" data-model="part14" style="left: 12dp; top: 732dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-14" class="Button-Load" />
                        <button id="Preset-Save-14" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-14" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-15" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-14" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                    <section id="Part-15" data-model="part15" style="left: 12dp; top: 784dp; width: 350dp; height: 46dp">
                        <button id="Preset-Load-15" class="Button-Load" />
                        <button id="Preset-Save-15" class="Button-Save" />
                        <knob id="PartVolume" />
                        <input id="Part-Volume-15" class="Slider-Mini" param="Part Volume" type="range" />
                        <knob id="PartPan" class="Knob-Mini" />
                        <button id="SelectPart" class="Button-Part-16" />
                        <button id="PresetPrev" class="Button-Preset-Up" />
                        <button id="PresetNext" class="Button-Preset-Down" />
                        <combo id="Preset-Name-15" class="Preset-Name">
                            <combotext id="PresetName"></combotext>
                        </combo>
                    </section>
                </section>
            </section>
        </section>
    </page>
    <page id="Easy" tabgroup="pages" tabpage="0" style="left: 422dp; top: 96dp; width: 1342dp; height: 834dp">
        <img src="Page-Easy.png" />
        <section id="Easy-Edit" style="left: 0dp; top: 0dp; width: 1342dp; height: 542dp">
            <knob id="Osc-Volume-Saturation" class="Knob-Big-Mini" param="Osc Mainvolume" style="left: 22dp; top: 170dp">
                <label>{{Osc_Mainvolume_text}}</label>
            </knob>
            <knob id="Sub-Osc-Volume" class="Knob-Big-Mini" param="Suboscillator Volume" style="left: 234dp; top: 170dp" data-class-disabled-opacity-40%="!((Osc1_Mode_value <= 1) || (Osc2_Mode_value == 1))">
                <label>{{Suboscillator_Volume_text}}</label>
            </knob>
            <knob id="Ring-Modulator-Volume" class="Knob-Big-Mini" param="Ringmodulator Volume" style="left: 446dp; top: 170dp">
                <label>{{Ringmodulator_Volume_text}}</label>
            </knob>
            <knob id="Filter-1-Resonance" class="Knob-Big-Mini" param="Filter1 Resonance" style="left: 1010dp; top: 170dp">
                <label>{{Filter1_Resonance_text}}</label>
            </knob>
            <knob id="Amplifier-Envelope-Attack" class="Knob-Middle" param="Amp Env Attack" style="left: 1226dp; top: 174dp" />
            <knob id="Amplifier-Envelope-Decay" class="Knob-Middle" param="Amp Env Decay" style="left: 1226dp; top: 280dp" />
            <section id="Filter-1-Cutoff-Easy" style="left: 700dp; top: 142dp; width: 258dp; height: 258dp">
                <knob id="Filter-1-Combobox-Fake" class="Filter-Combobox-Fake" param="Filter1 Mode" style="left: 88dp; top: 56dp" />
                <knob id="Knob-Filter-1-Cutoff-Easy" class="Knob-Big" param="Cutoff">
                    <label style="position: relative; left:0dp; top:68dp">{{Cutoff_text}}</label>
                    <canvas id="Filter-1-Easy-LCD" style="left:46dp; top:46dp; width:166dp; height:166dp;" />
                </knob>
                <combo id="Filter-1-Combobox" param="Filter1 Mode" style="overflow: visible; left: 88dp; top: 56dp; width: 82dp; height: 14dp">
                    <combotext style="display: none"></combotext>
                </combo>
            </section>
        </section>
        <section id="Soft-Knob" style="left: 0; top: 558dp; width: 822dp; height: 276dp">
            <combo id="Soft-Knob-1-Name" param="Soft Knob1 ShortName Main" style="left: 130dp; top: 128dp; width: 126dp; height: 30dp; padding-right: 10dp"></combo>
            <combo id="Soft-Knob-2-Name" param="Soft Knob2 ShortName Main" style="left: 396dp; top: 128dp; width: 126dp; height: 30dp; padding-right: 10dp"></combo>
            <combo id="Soft-Knob-3-Name" param="Soft Knob3 ShortName Main" style="left: 660dp; top: 128dp; width: 126dp; height: 30dp; padding-right: 10dp"></combo>
            <knob id="Soft-Knob-1" class="Knob-Middle-Led" param="Soft Knob Configuration/Value Softknob0" style="left: 26dp; top: 98dp" data-class-disabled-opacity-50%="!(Soft_Knob_1_Single_value >= 1)" />
            <knob id="Soft-Knob-2" class="Knob-Middle-Led" param="Soft Knob Configuration/Value Softknob1" style="left: 292dp; top: 98dp" data-class-disabled-opacity-50%="!(Soft_Knob_2_Single_value >= 1)" />
            <knob id="Soft-Knob-3" class="Knob-Middle-Led" param="Soft Knob Configuration/Value Softknob2" style="left: 556dp; top: 98dp" data-class-disabled-opacity-50%="!(Soft_Knobs_Destination_3_value >= 1)" />
        </section>
        <section id="Effects" style="left: 836dp; top: 558dp; width: 506dp; height: 276dp">
            <knob id="Delay-Send" class="Knob-Middle-Led" param="Delay Send" style="left: 26dp; top: 98dp" data-class-disabled-opacity-50%="!(Switches_Delay_Enable_value == 1)" />
            <knob id="Reverb-Send" class="Knob-Middle-Led" param="Reverb Send" style="left: 208dp; top: 98dp" data-class-disabled-opacity-50%="!(Switches_Reverb_Enable_value == 1)" />
            <section id="Chorus-Mix" style="left: 390dp; top: 98dp">
                <knob id="Chorus-Mix-0" class="Knob-Middle-Led" param="Chorus Mix" data-class-disabled-opacity-50%="!(Chorus_Type_value == 1)" />
                <knob id="Chorus-Mix-1" class="Knob-Middle-Led" param="Chorus Mix" data-class-disabled="!((Chorus_Type_value == 1 || Chorus_Type_value == 6))" />
                <knob id="Chorus-Mix-2" class="Knob-Middle-Led" param="Chorus/Mix2" data-class-disabled="!((Chorus_Type_value >= 2 && Chorus_Type_value <= 3))" />
                <knob id="Chorus-Mix-3" class="Knob-Chorus-Air" data-class-disabled="!(Chorus_Type_value == 4)" />
