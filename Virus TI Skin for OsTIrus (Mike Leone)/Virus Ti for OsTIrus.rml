                <label>{{Delay_Send_text}}</label>
            </knob>
        </section>
        <section id="Reverb" style="left: 0dp; top: 282dp; width: 1342dp; height: 270dp" data-class-disabled-opacity-50%="!(Switches_Reverb_Enable_value == 1)">
            <section id="Reverb-Components" data-class-disabled-opacity-50%="!(Reverb_Send_value > 0)">
