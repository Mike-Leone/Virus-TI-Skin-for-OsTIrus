        <url id="Github" url="https://github.com/dsp56300/gearmulator" style="left: 840dp; top: 740dp; width: 466dp; height: 16dp">https://github.com/dsp56300/gearmulator</url>
        <url id="Donate-Info" url="https://paypal.me/dsp56300" style="left: 840dp; top: 776dp; width: 310dp; height: 16dp">https://paypal.me/dsp56300</url>
        <text id="Version-Skin" style="left: 352dp; top: 742dp; width: 168dp; height: 16dp">02.09.26</text>
        <text id="DeviceModel" style="left: 352dp; top: 778dp; width: 168dp; height: 16dp"></text>
