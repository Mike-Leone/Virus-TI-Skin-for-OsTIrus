    <page id="FX-2" tabgroup="pages" tabpage="8" style="left: 422dp; top: 96dp; width: 1342dp; height: 834dp">
        <img src="Page-FX-2.png" />
        <section id="Delay" style="left: 0dp; top: 0dp; width: 1342dp; height: 270dp" data-class-disabled-opacity-50%="!((Switches_Delay_Enable_value == 1))">
            <section id="Delay-Type" style="left: 216dp; top: 26dp; width: 1126dp; height: 244dp" data-class-disabled-opacity-50%="!((Delay_Send_value > 0))">
                <section id="Classic" data-class-disabled="!(Delay_Type_value == 0)">
                    <img src="Delay-Classic.png" />
                    <section id="Classic-Components" data-class-disabled-opacity-50%="!(Delay_Mode_value > 0)">
                        <knob id="Time" class="Knob-Middle-Led" param="Delay Time" style="left: 354dp; top: 74dp" data-class-disabled-opacity-50%="!((Delay_Clock_value == 0 && Delay_Mode_value >= 0 && Delay_Mode_value <= 5))" />
                        <knob id="Feedback" class="Knob-Middle-Led" param="Delay Feedback" style="left: 474dp; top: 74dp" />
                        <knob id="Color" class="Knob-Middle" param="Delay Color" style="left: 606dp; top: 76dp" />
                        <knob id="Rate" class="Knob-Middle" param="Dly Rate / Rev Decay" style="left: 706dp; top: 76dp" />
                        <knob id="Depth" class="Knob-Middle" param="Dly Depth " style="left: 806dp; top: 76dp" />
                        <section id="Delay-LFO-Shape" style="left: 914dp; top: 88dp; width: 198dp; height: 62dp">
                            <button id="Delay-LFO-Sine" class="Button-LFO-Sine" param="Delay Lfo Shape" valueOn="0" isToggle="1" style="left: 4dp; top: 6dp" />
                            <button id="Delay-LFO-Triangle" class="Button-LFO-Triangle" param="Delay Lfo Shape" valueOn="1" isToggle="1" style="left: 4dp; top: 34dp" />
                            <button id="Delay-LFO-Saw" class="Button-LFO-Saw" param="Delay Lfo Shape" valueOn="2" isToggle="1" style="left: 68dp; top: 6dp" />
                            <button id="Delay-LFO-Square" class="Button-LFO-Square" param="Delay Lfo Shape" valueOn="3" isToggle="1" style="left: 68dp; top: 34dp" />
                            <button id="Delay-LFO-SH" class="Button-LFO-SH" param="Delay Lfo Shape" valueOn="4" isToggle="1" style="left: 132dp; top: 6dp" />
                            <button id="Delay-LFO-SG" class="Button-LFO-SG" param="Delay Lfo Shape" valueOn="5" isToggle="1" style="left: 132dp; top: 34dp" />
                        </section>
                        <combo id="Delay-Clock" class="combo-blue" param="Delay Clock" style="left: 242dp; top: 146dp; width: 80dp; height: 22dp; padding-left: 4dp; padding-right: 26dp" data-class-disabled-opacity-50%="!((Delay_Mode_value >= 0 && Delay_Mode_value <= 5))"></combo>
                    </section>
                    <combo id="Delay-Mode" class="combo-blue" param="Delay Mode" style="left: 22dp; top: 146dp; width: 188dp; height: 22dp; padding-left: 4dp"></combo>
                </section>
                <section id="Tape-Clocked" data-class-disabled="!(Delay_Type_value == 1)">
                    <img src="Delay-Clocked.png" />
                    <knob id="Time" class="Knob-Middle-Led" param="Delay/Tape Delay Time" style="left: 354dp; top: 74dp" data-class-disabled-opacity-50%="!(Delay_Tape_Delay_Left_Clock_value == -1)" />
                    <knob id="Feedback" class="Knob-Middle-Led" param="Delay/Tape Delay Feedback" style="left: 474dp; top: 74dp" />
                    <knob id="Center-Frequency" class="Knob-Middle" param="Delay/Tape Delay Center Frequency" style="left: 606dp; top: 76dp" />
                    <knob id="Bandwidth" class="Knob-Middle" param="Delay Tape Delay Bandwidth" style="left: 806dp; top: 76dp" />
                    <knob id="Modulation" class="Knob-Middle" param="Delay/Tape Delay Modulation" style="left: 1004dp; top: 76dp" />
                    <combo id="Clock-Left" class="combo-blue" param="Delay Tape Delay Left Clock" style="left: 22dp; top: 146dp; width: 134dp; height: 22dp"></combo>
                    <combo id="Clock-Right" class="combo-blue" param="Delay Tape Delay Right Clock" style="left: 186dp; top: 146dp; width: 136dp; height: 22dp"></combo>
                </section>
                <section id="Tape-Free/Doppler" data-class-disabled="!(Delay_Type_value >= 2)">
                    <img src="Delay-Free.png" />
                    <knob id="Time" class="Knob-Middle-Led" param="Delay/Tape Delay Time" style="left: 354dp; top: 74dp" />
                    <knob id="Feedback" class="Knob-Middle-Led" param="Delay/Tape Delay Feedback" style="left: 474dp; top: 74dp" />
                    <knob id="Center-Frequency" class="Knob-Middle" param="Delay/Tape Delay Center Frequency" style="left: 606dp; top: 76dp" />
                    <knob id="Bandwidth" class="Knob-Middle" param="Delay Tape Delay Bandwidth" style="left: 806dp; top: 76dp" />
