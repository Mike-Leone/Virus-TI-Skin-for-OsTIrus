                </section>
            </section>
            <knob id="Envelope 1" class="Knob-Middle-Led" param="Filter1 Env Amt" style="left: 26dp; top: 96dp" controllerLinkCondition="Filter-Filter-Link" controllerLinkTarget="Envelope 2" />
            <knob id="Resonance 1" class="Knob-Middle-Led" param="Filter1 Resonance" style="left: 386dp; top: 96dp" controllerLinkCondition="Filter-Filter-Link" controllerLinkTarget="Resonance 2" />
