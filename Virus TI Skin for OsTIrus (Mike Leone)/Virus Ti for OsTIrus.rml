                <knob id="Release" class="Knob-Middle" param="Vocoder/Release" style="left: 572dp; top: 154dp" />
                <knob id="Carrier-Center" class="Knob-Middle-Led-Bipolar" param="Vocoder/Carrier Center Frequency" style="left: 710dp; top: 102dp" />
                <knob id="Carrier-Spread" class="Knob-Middle" param="Vocoder/Modulator Frequency Spread" style="left: 1122dp; top: 104dp" controllerLinkCondition="Vocoder-Link" controllerLinkTarget="Modulator-Spread" />
                <knob id="Carrier-Q" class="Knob-Middle" param="Vocoder/Modulator Q Factor" style="left: 1022dp; top: 104dp" controllerLinkCondition="Vocoder-Link" controllerLinkTarget="Modulator-Q" />
                <knob id="Modulator-Q" class="Knob-Middle" param="Vocoder/Carrier Q Factor" style="left: 912dp; top: 104dp" controllerLinkCondition="Vocoder-Link" controllerLinkTarget="Carrier-Q" />
                <knob id="Modulator-Spread" class="Knob-Middle" param="Carrier Frequency Spread" style="left: 812dp; top: 104dp" controllerLinkCondition="Vocoder-Link" controllerLinkTarget="Carrier-Spread" />
                <knob id="Modulator-Offset" class="Knob-Middle-Led-Bipolar" param="Vocoder/Modulator Frequency Offset" style="left: 1220dp; top: 102dp" />
                <button id="Vocoder-Link" class="Button-Led" param="Vocoder Link" isToggle="1" style="left: 988dp; top: 182dp" />
            </section>
            <combo id="Vocoder-Mode" class="combo-blue" param="Vocoder Mode" style="left: 34dp; top: 112dp; width: 210dp; height: 22dp"></combo>
        </section>
        <button id="Delay-ON/OFF" class="Button-Led" param="Switches/Delay Enable" isToggle="1" style="left: 10dp; top: 214dp" />
        <button id="Reverb-ON/OFF" class="Button-Led" param="Switches/Reverb Enable" isToggle="1" style="left: 10dp; top: 496dp" />
