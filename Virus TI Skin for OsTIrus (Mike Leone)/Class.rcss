/* == SLIDERS == */

.Slider {
    width: 262dp;
    height: 34dp;
    position: absolute;
    box-sizing: border-box;
    decorator: image(Slider-Shadow.png);
}

.Slider sliderbar {
    width: 54dp;
    height: 46dp;
    margin: -6dp -4dp;
    decorator: image(Slider.png);
}

.Slider-Mini {
    left: 82dp;
    top: 22dp;
    width: 218dp;
    height: 24dp;
    position: absolute;
    box-sizing: border-box;
}

.Slider-Mini sliderbar {
    width: 54dp;
    height: 36dp;
    margin: -6dp -6dp;
    decorator: image(Slider-Mini.png);
}

.Snow .Slider-Mini {
    left: 106dp;
    top: 160dp;
    width: 246dp;
    height: 24dp;
    position: absolute;
    box-sizing: border-box;
}

.Snow .Slider-Mini sliderbar {
    width: 58dp;
    height: 36dp;
    margin: -6dp -6dp;
    decorator: image(Slider-Mini-Snow.png);
}

.Slider-Mini-Snow {
    display: none;
}

.Snow .Slider-Mini-Snow {
    left: 106dp;
    top: 126dp;
    width: 246dp;
    height: 24dp;
    position: absolute;
    box-sizing: border-box;
    display: block;
}

.Snow .Slider-Mini-Snow sliderbar {
    width: 58dp;
    height: 36dp;
    margin: -6dp -6dp;
    decorator: image(Slider-Mini-Snow.png);
}

.Slider-Arp {
    height: 22dp;
    width: 1246dp;
    position: absolute;
    box-sizing: border-box;
}

.Slider-Arp sliderbar {
    height: 22dp;
    width: 6dp;
    background-color: #b6c8e4;
}

.Slider-Arp sliderprogress {
    margin-left: -38dp;
    padding-right: 38dp;
    background-color: #8691A580;
}

.Slider-Surround-Balance {
    width: 226dp;
    height: 18dp;
    position: absolute;
    box-sizing: border-box;
}

.Slider-Surround-Balance sliderprogress {
    background-color: #b8becb;
}

.Slider-Surround-Balance sliderbar {
    width: 6dp;
    height: 18dp;
    background-color: #001941;
}

