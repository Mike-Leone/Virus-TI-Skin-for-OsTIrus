/* == KNOBS == */

.Knob-Mini {
    left: 302dp;
    top: 0dp;
    width: 48dp;
    height: 48dp;
    margin-top: -2dp;
    frames: 128;
    spriteprefix: knob-mini_;
}

.Snow .Knob-Mini {
    display: none;
}

page#Arpeggiator .Knob-Mini {
    margin-top: 0dp;
    margin-left: -6dp;
}

.Knob-Middle {
    width: 86dp;
    height: 86dp;
    frames: 128;
    spriteprefix: knob-middle_;
}

.Knob-Middle-Led {
    width: 90dp;
    height: 90dp;
    frames: 128;
    spriteprefix: knob-middle-led_;
}

.Knob-Middle-Led-Bipolar {
    width: 90dp;
    height: 90dp;
    frames: 128;
    spriteprefix: knob-middle-led-bipolar_;
}

.Knob-Big {
    width: 258dp;
    height: 258dp;
    frames: 128;
    spriteprefix: knob-big_;
}

.Knob-Big-Mini {
    width: 202dp;
    height: 202dp;
    frames: 128;
    spriteprefix: knob-big-mini_;
}

.Knob-Pulse-Width {
    width: 254dp;
    height: 42dp;
    frames: 60;
    spriteprefix: knob-pulse-width_;
}

.Knob-Filter-Routing {
    width: 254dp;
    height: 82dp;
    frames: 4;
    spriteprefix: knob-filter-routing_;
}

.Knob-Keytrack {
    width: 250dp;
    height: 42dp;
    frames: 128;
    spriteprefix: knob-keytrack_;
}

.Knob-Chorus-Air {
    left: -2dp;
    top: -2dp;
    width: 94dp;
    height: 94dp;
    decorator: image(knob-chorus-air);
}

.Knob-Chorus-Vibrato {
    left: -2dp;
    top: -2dp;
    width: 94dp;
    height: 94dp;
    decorator: image(knob-chorus-vibrato);
}

.Knob-Chorus-Rotary {
    width: 124dp;
    height: 62dp;
    frames: 2;
    spriteprefix: knob-chorus-rotary_;
}

