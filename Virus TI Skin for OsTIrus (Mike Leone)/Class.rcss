/* Preset Name Combobox */

/* for Ti */

.Preset-Name {
    left: 84dp;
    top: 2dp;
    width: 122dp;
    height: 18dp;
    padding-left: 0dp;
    padding-right: 0dp;
    decorator: none;
}

.Preset-Name-Active {
    decorator: image(LCD-Preset-Name.png scale-none);
}

/* for Snow */

.Snow .Preset-Name {
    left: 62dp;
    top: 14dp;
    height: 34dp;
    width: 198dp;
    padding: 0;
    decorator: none;
}

.Snow .Preset-Name > combotext {
    height: 34dp;
    width: 198dp;
    line-height: 34dp;
    border: 0;
    text-align: center;
}

.Snow .Preset-Name-Active {
    border-radius: 2dp;
    decorator: linear-gradient(180deg, #B0B6C0 0%, #B6BCC7 7.1%, #CAD1DD 15.4%, #D4DBE8 23.71%, #DAE2EE 33.62%, #E1E9F6 43.54%, #E1E9F6 52.92%, #E1E9F6 62.83%, #E1E9F6 72.21%, #E1E9F6 82.12%, #E1E9F6 90.43%, #DEE6F3 100%);
}

.Snow .Preset-Name-Active > combotext {
    color: #001941;
}

/* Other Classes */

.Custom-Display-Hide {
    opacity: 0;
    transition: opacity 0.000001s linear-in 1.5s;
}

.Changelog {
    line-height: 32dp;
    overflow: auto;
}

.Filter-Combobox-Fake {
    width: 82dp;
    height: 14dp;
    frames: 8;
    spriteprefix: filter-combobox-fake_;
}

.Filter-Combobox-Fake-2 {
    width: 82dp;
    height: 14dp;
    frames: 4;
    spriteprefix: filter-combobox-fake_;
}

#Donate {
    transition: transform 1s elastic-out;
    transform: scale(1.0);
    decorator: image(Donate.png);
}

#Donate:hover {
    transform: scale(1.04);
}

#QR {
    transition: transform 1s elastic-out;
    transform: scale(1.0);
    decorator: image(QR.png);
}

#QR:hover {
    transform: scale(1.02);
}



